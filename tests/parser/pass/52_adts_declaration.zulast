type a = int;
type b = float;
type optional =
    | Some of int
    | None;
type node =
    | Unit
    | Int of int
    | Float of float
    | String of string
    | Bool of bool
    | BinOp of bop * node * node;
---
TypeDeclaration ( a : int )
 TypeDeclaration ( b : float )
  TypeDeclaration ( optional :
   Some of int
   None
  )
   TypeDeclaration ( node :
    Unit
    Int of int
    Float of float
    String of string
    Bool of bool
    BinOp of (bop * node * node)
   )
    CurrentEnvironment
